# Cleon UI Configuration

# Server Configuration
PORT=3010
HOST=0.0.0.0
NODE_ENV=development

# Security (REQUIRED for production)
# JWT_SECRET must be at least 32 characters
JWT_SECRET=change-this-to-a-random-secure-string-at-least-32-chars

# CORS: Production domains (comma-separated)
# Local network IPs (192.168.x.x, 10.x.x.x) are always allowed for development
ALLOWED_ORIGINS=https://example.com

# Pi Coding Agent Configuration
# The pi binary must be installed: npm install -g @mariozechner/pi-coding-agent
# Configure API keys in Pi's own config: ~/.pi/agent/auth.json or via ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Override pi binary path (default: 'pi' from PATH)
# PI_BINARY=/opt/homebrew/bin/pi

CONTEXT_WINDOW=200000

# Optional: Logging (debug, info, warn, error)
LOG_LEVEL=info
